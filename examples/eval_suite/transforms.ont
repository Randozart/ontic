wrapping
fn EvalList.reverse(%xs: List<F64>, %n: Int) -> List<F64>
  | %n > 0 && len(%xs) == %n
  hint "map(i in range(n)) { index(xs, n - 1 - i) }"
  => [1.0, 2.0, 3.0], 3 -> [3.0, 2.0, 1.0] ± 1e-12
  => [7.0], 1 -> [7.0] ± 1e-12
  ?? [1.0, 2.0], 2 -> [2.0, 1.0] ± 1e-12

fn EvalAct.relu_list(%xs: List<F64>, %n: Int) -> List<F64>
  | %n > 0 && len(%xs) == %n
  hint "map(v in xs) { if v < 0.0 { 0.0 } else { v } }"
  => [-1.0, 0.0, 2.0], 3 -> [0.0, 0.0, 2.0] ± 1e-12
  => [5.0], 1 -> [5.0] ± 1e-12
  ?? [-4.0, -5.0], 2 -> [0.0, 0.0] ± 1e-12

fn EvalSig.softmax2(%a: F64, %b: F64) -> F64
  hint "let ea = exp(a); let eb = exp(b); ea / (ea + eb)"
  => 0.0, 0.0 -> 0.5 ± 1e-12
  => 1.0, 0.0 -> 0.7310585786300049 ± 1e-9
  ?? 2.0, 1.0 -> 0.7310585786300049 ± 1e-9

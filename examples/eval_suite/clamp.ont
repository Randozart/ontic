wrapping
fn EvalClamp.clamp(%x: F64, %lo: F64, %hi: F64) -> F64
  | %lo <= %hi
  hint "if %x < %lo { %lo } else { if %x > %hi { %hi } else { %x } }"
  => 5.0, 0.0, 10.0 -> 5.0 ± 1e-12
  => -3.0, 0.0, 10.0 -> 0.0 ± 1e-12
  ?? 15.0, 0.0, 10.0 -> 10.0 ± 1e-12

fn EvalLerp.lerp(%a: F64, %b: F64, %t: F64) -> F64
  | %t >= 0.0 && %t <= 1.0
  hint "%a + (%b - %a) * %t"
  => 0.0, 10.0, 0.5 -> 5.0 ± 1e-12
  => 2.0, 4.0, 0.25 -> 2.5 ± 1e-12
  ?? 1.0, 2.0, 1.0 -> 2.0 ± 1e-12

fn EvalSig.sigmoid(%x: F64) -> F64
  hint "1.0 / (1.0 + exp(0.0 - %x))"
  => 0.0 -> 0.5 ± 1e-12
  => 2.0 -> 0.8807970779778823 ± 1e-9
  ?? -2.0 -> 0.11920292202211755 ± 1e-9

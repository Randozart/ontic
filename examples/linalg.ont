wrapping
fn Linalg.dot(%a: List<F64>, %b: List<F64>) -> F64
  hint "fold over range(len(a)): acc + index(a,i) * index(b,i)"
  => [1.0, 2.0], [3.0, 4.0] -> 11.0 ± 1e-9
  ?? [1.0], [5.0] -> 5.0 ± 1e-12

fn Linalg.normalize(%xs: List<F64>) -> List<F64>
  hint "divide each element by the Euclidean norm: map(%v in %xs) { %v / sqrt(sum(%xs)) } — where sum includes the square root of sum-of-squares"
  => [3.0, 4.0] -> [0.6, 0.8] ± 1e-9
  => [1.0, 0.0] -> [1.0, 0.0] ± 1e-9
  ?? [0.0, 5.0] -> [0.0, 1.0] ± 1e-9

// Linalg library — building block wishes for mesh processing.
// Each gen here becomes a vault entry callable from later gens.
wrapping
fn Linalg.dot(%a: List<F64>, %b: List<F64>) -> F64
  => [1.0, 2.0], [3.0, 4.0] -> 11.0 ± 1e-9
  ?? [1.0], [5.0] -> 5.0 ± 1e-12

fn Linalg.matvec(%mat: List<F64>, %vec: List<F64>) -> List<F64>
  hint "row-major 2x2 matrix times vector; mat = [m00, m01, m10, m11]; result[i] = sum over j of mat[i*2+j] * vec[j]"
  => [1.0, 0.0, 0.0, 1.0], [3.0, 7.0] -> [3.0, 7.0] ± 1e-12
  ?? [2.0, 0.0, 0.0, 3.0], [1.0, 1.0] -> [2.0, 3.0] ± 1e-12

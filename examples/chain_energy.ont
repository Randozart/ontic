wrapping
use Chain.mv2
use Linalg.matvec
fn Chain.energy(%mat: List<F64>, %vec: List<F64>) -> F64
  | len(%vec) > 0
  | len(%mat) == len(%vec) * len(%vec)
  hint "never use list_append or to_int. Use exactly: fold v in Chain.mv2(mat, vec), acc from 0.0 { acc + v }"
  => [1.0, 0.0, 0.0, 1.0], [3.0, 7.0] -> 58.0 ± 1e-12
  => [2.0, 0.0, 0.0, 3.0], [1.0, 1.0] -> 13.0 ± 1e-12
  ?? [1.0, 2.0, 3.0, 4.0], [1.0, 1.0] -> 58.0 ± 1e-12

wrapping
fn Linalg.matvec(%mat: List<F64>, %vec: List<F64>) -> List<F64>
  hint "row-major NxN matrix times vector; use map over row indices, inner fold per row"
  hint "result[i] = fold %j in range(n), %acc from 0.0 { %acc + index(%mat, %i * n + %j) * index(%vec, %j) }"
  => [1.0, 0.0, 0.0, 1.0], [3.0, 7.0] -> [3.0, 7.0] ± 1e-12
  => [2.0, 0.0, 0.0, 3.0], [1.0, 1.0] -> [2.0, 3.0] ± 1e-12
  ?? [1.0, 2.0, 3.0, 4.0], [1.0, 1.0] -> [3.0, 7.0] ± 1e-12

wrapping
use Linalg.matvec
fn Chain.mv2(%mat: List<F64>, %vec: List<F64>) -> List<F64>
  | len(%vec) > 0
  | len(%mat) == len(%vec) * len(%vec)
  hint "never use list_append or to_int. Use exactly: map(v in matvec(mat, vec)) { v * v }"
  => [1.0, 0.0, 0.0, 1.0], [3.0, 7.0] -> [9.0, 49.0] ± 1e-12
  => [2.0, 0.0, 0.0, 3.0], [1.0, 1.0] -> [4.0, 9.0] ± 1e-12
  ?? [1.0, 2.0, 3.0, 4.0], [1.0, 1.0] -> [9.0, 49.0] ± 1e-12

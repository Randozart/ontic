// Ledger.total, wrapping tier: arithmetic wraps mod 2^64 by declaration.
// Speed requires the word; probes for overflow are meaningless here.
wrapping
fn Ledger.total(%items: List<Int>) -> Int
  | %res >= -1000000000
  => [1,2,3] -> 6
  => [] -> 0
  => [5] -> 5
  ?? [4,5] -> 9
  ?? [10,20,30,40] -> 100

wrapping
fn Vec.shift(%xs: List<F64>, %n: Int, %k: Int) -> List<F64>
  | len(%xs) == %n
  | %n > 0
  hint "map(i in range(%n)) { let idx = (%k + i) % %n; index(%xs, if idx < 0 { idx + %n } else { idx }) }"
  => [1.0, 2.0, 3.0, 4.0], 4, 1 -> [2.0, 3.0, 4.0, 1.0] ± 1e-12
  => [10.0, 20.0, 30.0], 3, -1 -> [30.0, 10.0, 20.0] ± 1e-12
  ?? [5.0, 15.0, 25.0, 35.0], 4, 2 -> [25.0, 35.0, 5.0, 15.0] ± 1e-12

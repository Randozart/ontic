wrapping
use Stats.mean
use Stats.rms
fn Stats.zscore(%xs: List<F64>) -> List<F64>
  | len(%xs) > 0
  hint "let m = Stats.mean(%xs); let s = Stats.rms(%xs); map(x in %xs) { (x - m) / s }"
  => [0.0, 2.0] -> [-1.0, 1.0] ± 1e-12
  => [1.0, 3.0, 5.0] -> [-1.22474487139, 0.0, 1.22474487139] ± 1e-11
  ?? [10.0, 20.0, 30.0] -> [-1.22474487139, 0.0, 1.22474487139] ± 1e-11

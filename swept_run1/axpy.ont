wrapping
fn Vec.axpy(%a: F64, %x: List<F64>, %y: List<F64>, %n: Int) -> List<F64>
  | len(%x) == %n
  | len(%y) == %n
  | %n > 0
  hint "map(i in range(%n)) { %a * index(%x, i) + index(%y, i) }"
  => 2.0, [1.0, 2.0], [3.0, 4.0], 2 -> [5.0, 8.0] ± 1e-12
  => 0.5, [10.0, 20.0], [1.0, 2.0], 2 -> [6.0, 12.0] ± 1e-12
  ?? -1.0, [3.0, 4.0], [10.0, 20.0], 2 -> [7.0, 16.0] ± 1e-12

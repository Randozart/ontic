wrapping
fn Vec.hadamard(%a: List<F64>, %b: List<F64>, %n: Int) -> List<F64>
  | len(%a) == %n && len(%b) == %n && %n > 0
  hint "map(i in range(%n)) { index(%a, i) * index(%b, i) }"
  => [1.0, 2.0], [3.0, 4.0], 2 -> [3.0, 8.0] ± 1e-12
  => [0.5, -2.0], [4.0, 0.5], 2 -> [2.0, -1.0] ± 1e-12
  ?? [10.0, 20.0, 30.0], [0.1, 0.2, 0.3], 3 -> [1.0, 4.0, 9.0] ± 1e-12

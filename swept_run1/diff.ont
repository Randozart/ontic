wrapping
fn Sig.diff(%xs: List<F64>, %n: Int) -> List<F64>
  | len(%xs) == %n
  | %n > 1
  | len(res) == %n - 1
  hint "map(i in range(%n - 1)) { index(%xs, i + 1) - index(%xs, i) }"
  => [1.0, 3.0, 6.0], 3 -> [2.0, 3.0] ± 1e-12
  => [0.0, 5.0, 2.0, 10.0], 4 -> [5.0, -3.0, 8.0] ± 1e-12
  ?? [10.0, 12.0, 15.0, 20.0, 27.0], 5 -> [2.0, 3.0, 5.0, 7.0] ± 1e-12

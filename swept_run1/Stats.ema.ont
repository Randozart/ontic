wrapping
fn Stats.ema(%xs: List<F64>, %alpha: F64) -> List<F64>
    | len(%xs) > 0
    | %alpha >= 0.0
    | %alpha <= 1.0
    | len(res) == len(%xs)
    hint "fold i in range(len(%xs)), acc from [index(%xs, 0)] { let prev = index(acc, len(acc) - 1); let curr = index(%xs, i); if i == 0 { acc } else { list_append(acc, prev + %alpha * (curr - prev)) } }"
    => [1.0, 2.0, 3.0], 0.5 -> [1.0, 1.5, 2.25] ± 1e-12
    => [10.0, 20.0, 30.0], 0.0 -> [10.0, 10.0, 10.0] ± 1e-12
    ?? [5.0, 5.0, 5.0], 1.0 -> [5.0, 5.0, 5.0] ± 1e-12

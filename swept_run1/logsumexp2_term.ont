wrapping
use Newt.sqrt

fn Num.logsumexp2_term(%a: F64, %b: F64) -> F64
  | %a >= -1000.0 && %a <= 1000.0 && %b >= -1000.0 && %b <= 1000.0
  hint "let m = if %a > %b { %a } else { %b }; let diff = if %a > %b { %a - %b } else { %b - %a }; m + log(1.0 + exp(0.0 - diff))"
  => 0.0, 0.0 -> 0.6931471805599453 ± 1e-12
  => 1.0, 2.0 -> 2.3132616875182228 ± 1e-12
  ?? 0.0, 1.0 -> 1.3132616875182228 ± 1e-12

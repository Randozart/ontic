wrapping
fn Sig.rectify_diff(%xs: List<F64>, %n: Int) -> List<F64>
  | len(%xs) == %n
  | %n > 1
  hint "map(i in range(%n - 1)) { let d = index(%xs, i + 1) - index(%xs, i); if d > 0.0 { d } else { 0.0 } }"
  => [1.0, 3.0, 2.0, 6.0], 4 -> [2.0, 0.0, 4.0] ± 1e-12
  => [5.0, 2.0, 8.0], 3 -> [0.0, 6.0] ± 1e-12
  ?? [0.0, 10.0, 5.0, 5.0, 12.0], 5 -> [10.0, 0.0, 0.0, 7.0] ± 1e-12
